# ─── Backend API URL ──────────────────────────────────────────────
# URL backend Express.js — sesuaikan jika di-deploy ke server lain
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Konfigurasi Peta ─────────────────────────────────────────────
# Koordinat default pusat peta saat pertama kali dibuka (Jakarta)
NEXT_PUBLIC_MAP_DEFAULT_LAT=-6.2088
NEXT_PUBLIC_MAP_DEFAULT_LNG=106.8456
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# ─── App Metadata ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=JalanRusak
NEXT_PUBLIC_APP_DESCRIPTION=Platform pelaporan jalan rusak berbasis komunitas
