// Prisma schema — mapped ke database yang sudah ada
// Enum & model menggunakan nama TypeScript-friendly (UPPERCASE, PascalCase)
// @map / @@map menghubungkan ke nama kolom/tabel aktual di PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum Role {
  PUBLIC          @map("public")
  VERIFIER        @map("verifier")
  FIELD_VERIFIER  @map("field_verifier")
  ADMIN           @map("admin")

  @@map("user_role")
}

enum ReportStatus {
  PENDING     @map("pending")
  VERIFIED    @map("verified")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  REJECTED    @map("rejected")

  @@map("report_status")
}

enum DamageType {
  BERLUBANG @map("berlubang")
  RETAK     @map("retak")
  AMBLAS    @map("amblas")
  BANJIR    @map("banjir")
  LONGSOR   @map("longsor")
  LAINNYA   @map("lainnya")

  @@map("damage_type")
}

enum AuthProvider {
  LOCAL  @map("local")
  GOOGLE @map("google")

  @@map("auth_provider")
}

// ─── Models ───────────────────────────────────────────────────────

model AppRole {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(50)
  displayName String    @map("display_name") @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  users User[]

  @@map("roles")
}

model User {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String       @db.VarChar(100)
  email        String       @unique @db.VarChar(100)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  provider     AuthProvider @default(LOCAL)
  providerId   String?      @map("provider_id") @db.VarChar(255)
  role         Role?        @default(PUBLIC)
  phone        String?      @db.VarChar(20)
  avatarUrl    String?      @map("avatar_url") @db.VarChar(500)
  roleId       String?      @map("role_id") @db.Uuid
  isActive     Boolean?     @default(true) @map("is_active")
  isVerified   Boolean?     @default(false) @map("is_verified")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamp(6)
  createdAt    DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  roleInfo      AppRole?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  reports       Report[]
  statusChanges StatusHistory[]
  sessions      Session[]

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([tokenHash], map: "idx_sessions_token_hash")
  @@index([userId], map: "idx_sessions_user_id")
  @@map("user_sessions")
}

model Region {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String    @db.VarChar(100)
  level     String?   @db.VarChar(20)
  parentId  String?   @map("parent_id") @db.Uuid
  boundary  Unsupported("geometry")?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id], onUpdate: NoAction)
  children Region[] @relation("RegionHierarchy")
  reports  Report[]

  @@index([boundary], map: "idx_regions_boundary", type: Gist)
  @@index([parentId], map: "idx_regions_parent")
  @@map("regions")
}

model Report {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportNumber String       @unique @map("report_number") @db.VarChar(20)
  userId       String?      @map("user_id") @db.Uuid
  regionId     String?      @map("region_id") @db.Uuid
  title        String       @db.VarChar(200)
  description  String?
  damageType   DamageType   @default(BERLUBANG) @map("damage_type")
  severity     Int          @db.SmallInt
  location     Unsupported("geometry")?
  latitude     Float
  longitude    Float
  address      String?      @db.VarChar(300)
  roadName     String?      @map("road_name") @db.VarChar(200)
  status       ReportStatus @default(PENDING)
  isAnonymous  Boolean?     @default(false) @map("is_anonymous")
  viewsCount   Int?         @default(0) @map("views_count")
  reportedAt   DateTime?    @default(now()) @map("reported_at") @db.Timestamp(6)
  updatedAt    DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user          User?          @relation(fields: [userId], references: [id], onUpdate: NoAction)
  region        Region?        @relation(fields: [regionId], references: [id], onUpdate: NoAction)
  photos        Photo[]
  statusHistory StatusHistory[]

  @@index([damageType], map: "idx_reports_damage_type")
  @@index([location], map: "idx_reports_location", type: Gist)
  @@index([regionId], map: "idx_reports_region_id")
  @@index([reportedAt(sort: Desc)], map: "idx_reports_reported_at")
  @@index([severity], map: "idx_reports_severity")
  @@index([status], map: "idx_reports_status")
  @@index([userId], map: "idx_reports_user_id")
  @@map("road_reports")
}

model Photo {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportId          String    @map("report_id") @db.Uuid
  statusHistoryId   String?   @map("status_history_id") @db.Uuid
  url               String    @db.VarChar(500)
  storagePath       String?   @map("storage_path") @db.VarChar(500)
  filename          String?   @db.VarChar(255)
  fileSize          Int?      @map("file_size")
  mimeType          String?   @map("mime_type") @db.VarChar(50)
  orderIndex        Int?      @default(0) @map("order_index") @db.SmallInt
  isPrimary         Boolean?  @default(false) @map("is_primary")
  uploadedAt        DateTime? @default(now()) @map("uploaded_at") @db.Timestamp(6)

  report        Report         @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  statusHistory StatusHistory? @relation(fields: [statusHistoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([reportId, isPrimary], map: "idx_photos_is_primary")
  @@index([reportId], map: "idx_photos_report_id")
  @@index([statusHistoryId], map: "idx_photos_status_history_id")
  @@map("report_photos")
}

model StatusHistory {
  id        String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportId  String        @map("report_id") @db.Uuid
  changedBy String?       @map("changed_by") @db.Uuid
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  notes     String?
  changedAt DateTime?     @default(now()) @map("changed_at") @db.Timestamp(6)

  report      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User?   @relation(fields: [changedBy], references: [id], onUpdate: NoAction)
  proofPhotos Photo[]

  @@index([reportId], map: "idx_status_history_report_id")
  @@map("report_status_history")
}
