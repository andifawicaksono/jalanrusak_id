# ─── Database ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/jalanrusak"

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend URL (untuk CORS) ────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── JWT Authentication ───────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman di production!
JWT_SECRET=ganti-dengan-secret-yang-sangat-panjang-dan-aman
JWT_EXPIRES_IN=7d

# ─── File Upload ──────────────────────────────────────────────────
# Folder tempat foto disimpan (relatif dari root backend)
UPLOAD_DIR=uploads
# Ukuran maksimal file dalam bytes (default: 5MB)
MAX_FILE_SIZE=5242880
# URL base API (digunakan untuk membuat URL publik foto)
API_BASE_URL=http://localhost:3001

# ─── Storage Provider ─────────────────────────────────────────────
# Opsi: local | minio | s3  (default: local)
# Ganti provider tanpa mengubah kode — cukup ubah nilai ini
STORAGE_TYPE=local

# MinIO Configuration (aktifkan jika STORAGE_TYPE=minio)
# Install dulu: npm install minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=jalanrusak
# MINIO_USE_SSL=false

# AWS S3 Configuration (aktifkan jika STORAGE_TYPE=s3)
# Install dulu: npm install @aws-sdk/client-s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=jalanrusak
# AWS_CLOUDFRONT_URL=https://xxx.cloudfront.net  (opsional, untuk CDN)

JWT_ACCESS_SECRET=secret-panjang-untuk-access-token
JWT_REFRESH_SECRET=secret-berbeda-untuk-refresh-token
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

